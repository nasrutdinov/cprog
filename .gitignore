# ==========================================
# Директории сборки (Build Directories)
# ==========================================
# Исключаем стандартные папки, куда компилируется проект
/[Bb]uild/
/build-*/
/out/
/CMakeBuild/

# ==========================================
# Файлы, создаваемые CMake
# ==========================================
# Исключаем кэш и служебные файлы CMake, если сборка запущена в корне
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json

# ==========================================
# Локальные зависимости и пакетные менеджеры
# ==========================================
# Если вы используете vcpkg, conan или FetchContent в корне проекта
/vcpkg_installed/
/.conan/
/_deps/

# ==========================================
# Временные файлы компилятора и артефакты
# ==========================================
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.gch
*.pch

# ==========================================
# Настройки популярных IDE
# ==========================================

# CLion
.idea/
cmake-build-*/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Visual Studio
.vs/
*.user
*.suo
*.sln
*.vcxproj

# Xcode
*.xcodeproj/
*.xcworkspace/


# Вспомогательные файлы LaTeX
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.ind
*.glg
*.glo
*.gls
*.idx
*.ilg
*.ist
*.synctex.gz

# Файлы от latexmk
*.fdb_latexmk
*.fls

# PDF и прочие выходные форматы
*.pdf
*.dvi
*.ps

# Временные и резервные файлы редакторов
*~
*.bak
*.swp
*.swo
\#*\#

# Папки сборки (если используете отдельные директории)
/build/
/tmp/
/output/

# Кэш и настройки IDE (опционально)
.idea/
.vscode/
*.iml

