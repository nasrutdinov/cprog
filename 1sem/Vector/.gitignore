# ==========================================
# Директории сборки (Build Directories)
# ==========================================
# Исключаем стандартные папки, куда компилируется проект
/[Bb]uild/
/build-*/
/out/
/CMakeBuild/

# ==========================================
# Файлы, создаваемые CMake
# ==========================================
# Исключаем кэш и служебные файлы CMake, если сборка запущена в корне
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json

# ==========================================
# Локальные зависимости и пакетные менеджеры
# ==========================================
# Если вы используете vcpkg, conan или FetchContent в корне проекта
/vcpkg_installed/
/.conan/
/_deps/

# ==========================================
# Временные файлы компилятора и артефакты
# ==========================================
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.gch
*.pch

# ==========================================
# Настройки популярных IDE
# ==========================================

# CLion
.idea/
cmake-build-*/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Visual Studio
.vs/
*.user
*.suo
*.sln
*.vcxproj

# Xcode
*.xcodeproj/
*.xcworkspace/
